# DIQQAT (real serverga o'rnatishda): APP_ENV=production, APP_DEBUG=false va APP_URL=https://... qiling.
# APP_DEBUG=true bo'lsa, xatolik sahifalarida server yo'llari va sozlamalar (sirlar emas, lekin ichki
# tuzilma) ko'rinib qoladi - shuning uchun jonli serverda albatta false. "Tizim holati" sahifasi buni
# unutib qo'yilgan bo'lsa ogohlantiradi.
APP_NAME="Edunova CRM"
APP_ENV=local
APP_KEY=
# Eski bazani ko'chirishda (Eski bazani ko'chirish): eski tizimning APP_KEY i
LEGACY_APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz

# "daily" - loglar kuniga bitta faylga yoziladi va 14 kundan eskisi avtomatik o'chadi (LOG_DAILY_DAYS).
# "stack" + "single" (eski standart) bitta laravel.log faylini cheksiz kattalashtiradi - serverda tavsiya etilmaydi.
LOG_CHANNEL=daily
# Jonli serverda "warning" qiling (faqat muammolar yoziladi) - "debug" yozishda foydali, lekin serverda
# faylni tezroq to'ldiradi.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edunova_crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
# Jonli serverda https bo'lsa true qiling - sessiya cookie'si faqat https orqali yuboriladi.
# Bo'sh qoldirilsa, so'rov https bo'lganda Laravel o'zi xavfsiz deb belgilaydi.
SESSION_SECURE_COOKIE=
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Birinchi sAdmin akkaunti (php artisan db:seed paytida yaratiladi)
SADMIN_NAME="Bosh administrator"
SADMIN_USERNAME=sadmin
SADMIN_PASSWORD=

# Eskiz.uz (umumiy akkaunt). Filialning o'z akkaunti bo'lsa, filial sozlamalarida kiritiladi.
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# OpenAI (kalitni faqat shu yerga yozing, boshqa joyga yozmang)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_DAILY_LIMIT=200

MONITOR_BEAT_KEY=

# Docker / Cloudflare Tunnel orqasida: *  (oddiy Nginx bilan bir mashinada: 127.0.0.1,::1)
TRUSTED_PROXIES=127.0.0.1,::1

# Eski bazani veb orqali ko'chirish: faqat ko'chirish paytida true qiling, tugagach olib tashlang
LEGACY_IMPORT_ENABLED=false

# Zaxira ZIP paroli (tavsiya: 24+ belgi). Bo'sh bo'lsa, tizim o'zi yaratib bazada (APP_KEY bilan shifrlab) saqlaydi
BACKUP_ZIP_PASSWORD=

# --- Redis (ixtiyoriy; serverda tavsiya etiladi) ------------------------------------------------------------
# Redis ishlatish uchun: CACHE_STORE=failover (Redis yiqilsa fayl keshiga o'tadi), QUEUE_CONNECTION=redis.
# SESSION_DRIVER=database QOLADI: "Seanslar" va "parol tiklanganda hamma qurilmadan chiqarish" bazadagi sessions jadvaliga tayanadi.
# Bir Redis'ni bir nechta loyiha ishlatsa, REDIS_PREFIX va CACHE_PREFIX har loyihada BOSHQA bo'lsin.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=edunova_
CACHE_PREFIX=edunova_cache_
REDIS_QUEUE_RETRY_AFTER=180
