# Nusxa oling: cp watchdog.env.example watchdog.env  va to'ldiring (bu faylni hech kimga bermang)
SITE_URL="https://temuriy-crm.uz/public"
BOT_TOKEN="123456:ABC..."          # Telegram bot tokeni (Tizim → Telegram bot dagi bilan bir xil bo'lishi shart emas, alohida bot ham mumkin)
CHAT_IDS="111111111 222222222"     # Admin Telegram ID lari (botga /id yozsangiz ko'rsatadi)
# BEAT_KEY="..."                   # ixtiyoriy: Tizim holati sahifasida ko'rsatilgan kalit (monitoring o'chib qolsa ilova sizni ogohlantiradi)
# FAILS_BEFORE_ALERT=3
# REMINDER_MINUTES=60
# NAME="Edunova CRM"
